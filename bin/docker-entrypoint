#!/bin/bash -e

# The web container migrates and seeds before serving (SPECS.md §19). The seeds are idempotent and
# never overwrite existing rows, so running them on every start only adds what is new.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare db:seed
fi

exec "${@}"
