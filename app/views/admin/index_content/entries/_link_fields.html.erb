<div class="ix-link-row" data-index-links-row>
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :position, data: { index_links_position: true } %>
  <%= f.text_field :label, placeholder: "Label", "aria-label": "Link label" %>
  <%= f.url_field :url, placeholder: "https://…", "aria-label": "Link URL" %>
  <%= f.text_field :note, placeholder: "Note (optional)", "aria-label": "Link note" %>
  <% if f.object.persisted? %>
    <label class="ix-link-remove" title="Remove this link when saving"><%= f.check_box :_destroy %> Remove</label>
  <% else %>
    <button type="button" class="btn-secondary btn-small" data-action="index-links#remove">Remove</button>
  <% end %>
</div>
