<% content_for :title, "Index sections" %>
<%= render "admin/index_content/tabs" %>
<div class="section-head">
  <h1>Sections</h1>
  <%= link_to "Add a section", new_admin_index_section_path, class: "button" %>
</div>
<p class="muted">Sections are the index's menu. <strong>Cards</strong> sections appear as cards on the front page; <strong>table</strong>
  sections get a page of their own with a compact table. Each is shown to all Tourpaq staff, or only to the chosen groups.</p>

<div class="table-wrap">
  <table>
    <thead><tr><th class="num">Order</th><th>Name</th><th>Layout</th><th>Shown to</th><th>Description</th><th class="num">Entries</th><th></th></tr></thead>
    <tbody>
      <% @sections.each do |section| %>
        <tr>
          <td class="num muted"><%= section.position %></td>
          <td><%= link_to section.name, edit_admin_index_section_path(section) %></td>
          <td><%= section.table? ? "Table" : "Cards" %></td>
          <td class="wrap"><%= section.visibility_label %></td>
          <td class="muted wrap"><%= section.description %></td>
          <td class="num"><%= @counts.fetch(section.id, 0) %></td>
          <td class="actions-cell"><%= link_to "View", index_host_url("/groups/#{section.to_param}"), class: "btn-secondary btn-small" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
