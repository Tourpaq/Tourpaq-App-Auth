<% content_for :title, "Profile" %>
<h1><%= @user.display_name %></h1>
<p class="muted">Your name and email come from Microsoft Entra ID and are updated each time you sign in.</p>

<div class="card">
  <dl class="facts">
    <dt>Name</dt><dd><%= @user.name.presence || tag.span("—", class: "muted") %></dd>
    <dt>Email</dt><dd><%= @user.email %></dd>
    <% if @user.upn.present? && @user.upn != @user.email %><dt>Account</dt><dd><%= @user.upn %></dd><% end %>
    <dt>Last sign-in</dt><dd><%= local_time(@user.last_login_at) %></dd>
  </dl>
</div>

<h2>My access</h2>
<% if @access.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>App</th><th>Role</th><th>From</th></tr></thead>
      <tbody>
        <% @access.each do |access| %>
          <tr>
            <td><%= access.app.name %></td>
            <% if access.multiple? %>
              <td colspan="2"><%= effective_role_label(access) %></td>
            <% else %>
              <td><%= role_badge(access) %></td>
              <td class="muted"><%= access.direct? ? "given to you directly" : "group #{access.source}" %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No access to any app yet. An admin has been told.</p>
<% end %>

<h2>Sessions</h2>
<p class="muted small">Your sign-ins (auth) and the index's own sessions (index). A session ends after 8 hours without use, and 7 days after the Microsoft sign-in.</p>
<div class="table-wrap">
  <table>
    <thead><tr><th>Host</th><th>Browser</th><th>IP</th><th>Signed in</th><th>Last seen</th><th></th></tr></thead>
    <tbody>
      <% @sessions.each do |row| %>
        <tr>
          <td><span class="pill pill-muted"><%= row.host_label %></span></td>
          <td><%= row.browser_label %><% if row == Current.session %> <span class="pill pill-ok">this browser</span><% end %></td>
          <td class="mono"><%= row.ip_address %></td>
          <td><%= local_time(row.created_at) %></td>
          <td><%= relative_time(row.last_seen_at) %></td>
          <td class="actions-cell"><%= button_to "End", index_profile_session_path(row), method: :delete, class: "btn-secondary btn-small danger" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2>Signed-in extensions</h2>
<% if @extensions.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Extension</th><th>App</th><th>Signed in</th><th>Last used</th><th></th></tr></thead>
      <tbody>
        <% @extensions.each do |token| %>
          <tr>
            <td><%= token.client.name.presence || token.client.client_id %></td>
            <td><%= token.client.app&.name %></td>
            <td><%= local_time(ExtensionSignIns.signed_in_at(token)) %></td>
            <td><%= relative_time(token.last_used_at || token.created_at) %></td>
            <td class="actions-cell"><%= button_to "Sign out", index_profile_extension_path(token), method: :delete, class: "btn-secondary btn-small danger" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No browser extension is signed in.</p>
<% end %>

<h2>API and MCP tokens</h2>
<p>Personal tokens for scripts, Claude Code and MCP clients are on the <%= link_to "Tokens", "/tokens" %> page.</p>
