<%# The INDEX host's layout (SPECS.md §24.1, §24.3): the dark sidebar with the index's navigation (search, the
    sections and docs the viewer may see: index/shared/_nav), then Profile and Tokens. A page may add more with
    content_for(:index_nav). %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Tourpaq" : "Tourpaq" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Tourpaq">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% if index_signed_in? %>
    <body class="index">
      <div class="app">
        <nav class="sidebar">
          <div class="brand"><img src="/favicon.svg" alt="">Tourpaq</div>
          <%= render "index/shared/nav" %>
          <%= yield :index_nav %>
          <div class="nav-section">You</div>
          <%= nav_link "Profile", index_profile_path %>
          <%= nav_link "Tokens", index_tokens_path %>
          <% if current_user.admin? %>
            <div class="nav-section">Admin</div>
            <%= link_to "Admin", admin_host_url, class: "nav-item" %>
          <% end %>

          <div class="whoami">
            <div class="who">
              <span class="name" title="<%= current_user.email %>"><%= current_user.display_name %></span>
            </div>
            <%= button_to "Sign out", index_session_path, method: :delete, form: { data: { turbo: false } } %>
          </div>
        </nav>

        <main class="content">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </body>
  <% else %>
    <body class="auth">
      <div class="auth-wrap">
        <div class="auth-brand"><img src="/favicon.svg" alt="">Tourpaq</div>
        <main class="auth-card">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
        <div class="auth-footer">The journeybooking index</div>
      </div>
    </body>
  <% end %>
</html>
