{
  "manifest_version": 3,
  "name": "Tourpaq Index",
  "short_name": "Tourpaq Index",
  "description": "Every app, server, dashboard and doc from index.app.journeybooking.eu, searchable in the side panel.",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tourpaq Index",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Open or close Tourpaq Index"
    }
  },
  "permissions": ["sidePanel", "storage", "identity"],
  "host_permissions": [
    "https://index.app.journeybooking.eu/*",
    "https://auth.app.journeybooking.eu/*",
    "http://index.localhost:3050/*",
    "http://auth.localhost:3050/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
