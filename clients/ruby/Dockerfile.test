# The image bin/docker-test runs the gem's tests in: Ruby 4.0.7 plus a compiler for native gems
# (bigdecimal, racc via actionpack). The gem directory is mounted, gems live in a volume.
FROM docker.io/library/ruby:4.0.7-slim
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential libyaml-dev git && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
ENV BUNDLE_PATH="/usr/local/bundle"
WORKDIR /gem
