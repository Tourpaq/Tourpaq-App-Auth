# LOCAL DEVELOPMENT: copy to .env and fill in. The .env file is gitignored.
# bin/docker-dev passes it to the dev container; docker compose reads it for interpolation.
# Tests ignore it (config/initializers/auth.rb fixes the test hosts and tenant).
# Never put production secrets here; locally Entra stays empty (the fake identity provider stands in).
#
# CONTAINER DEPLOYS (Coolify): there is no .env file on the host. Set these same names as
# environment variables on the resource (Coolify: "Environment Variables").

# --- Rails ---------------------------------------------------------------------
# Required in production (docker compose refuses to start without it): openssl rand -hex 64
# SECRET_KEY_BASE=

# --- The three hosts (SPECS.md §24.1, §19) ---------------------------------------
# One app, three host names; everything is behind NetBird. Browsers resolve *.localhost to your machine.
# AUTH: Entra sign-in, the OIDC provider, the API, introspection, "waiting for access". THE ISSUER, exactly:
# production https://auth.app.journeybooking.eu (the apps' LOGIN_ISSUER).
APP_URL=http://auth.localhost:3050
# INDEX: the index, profile and personal tokens. Production https://index.app.journeybooking.eu
INDEX_URL=http://index.localhost:3050
# ADMIN: the admin UI only; limited to admins in NetBird. Production https://admin.app.journeybooking.eu
ADMIN_URL=http://admin.localhost:3050
# Optional back-channel hosts ("host" or "host:port", comma-separated): apps on a shared Docker network (or in
# local testing) call discovery, JWKS, /oauth/token, /oauth/introspect, /oauth/revoke, /oauth/userinfo and
# /api/v1/* there (their LOGIN_INTERNAL_URL). Nothing else answers on them; the issuer stays APP_URL.
# AUTH_INTERNAL_HOSTS=host.docker.internal:3050,auth:3050
# Optional: refuse admin requests from other client addresses (comma-separated CIDRs), e.g. NetBird's.
# ADMIN_ALLOWED_CIDRS=100.64.0.0/10
# Optional: the proxies allowed to set X-Forwarded-For/Host (comma-separated CIDRs). Default: loopback
# and private ranges (Coolify's Traefik on the Docker network). Others' forwarded headers are dropped.
# TRUSTED_PROXIES=10.0.1.0/24

# --- Database ------------------------------------------------------------------
# Locally: leave DATABASE_URL unset. Development and tests use SQLite under storage/ only (SPECS.md §24.4).
# Production only (Coolify): the Tourpaq App Platform's PostgreSQL, created with `bin/create-app tourpaq_auth`
# in ../Tourpaq-App-Platform. One database: the Solid Queue tables live in it too.
# DATABASE_URL=   # production only
# DB_POOL=15
# Tests only: a separate SQLite file so several test runs can work side by side.
# TEST_DB=storage/test_other.sqlite3

# --- Microsoft Entra ID (SPECS.md §3) ----------------------------------------------
# One app registration in our tenant: single tenant, platform Web, delegated openid profile email, and the
# optional ID-token claim auth_time (Token configuration): fresh and admin sign-ins are refused without it.
# Its only redirect URI is the Dashboard's https://home.app.journeybooking.eu/auth/entra_id/callback until IT
# adds https://auth.app.journeybooking.eu/auth/entra_id/callback (SPECS.md §24.2).
# The three values come from IT and go ONLY into Coolify's environment, never into the repository.
# Locally they stay empty: the fake identity provider (/dev/sign_in) stands in for Entra.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# The secret's expiry (YYYY-MM-DD): the admin UI warns 30 days ahead.
# ENTRA_CLIENT_SECRET_EXPIRES_ON=2028-10-16
# The redirect_uri sent to Entra (authorization request and code exchange). Default: APP_URL's own callback.
# While the registration only has home.app's callback, production sets it to that URL and the Dashboard forwards
# the GET (query kept) to the auth host; unset it once IT has added the auth host's callback.
# ENTRA_REDIRECT_URI=https://home.app.journeybooking.eu/auth/entra_id/callback

# --- OIDC provider (SPECS.md §7.3, §14) -------------------------------------------
# Required in production (the app refuses to start without it). Development generates
# tmp/oidc_dev_signing_key.pem when unset. The JWKS kid is the key's thumbprint.
# RSA 2048+ private key, PEM (newlines may be written as \n):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# OIDC_SIGNING_KEY=
# During a rotation, the old key, still published in the JWKS:
# OIDC_PREVIOUS_SIGNING_KEY=

# --- Sessions (SPECS.md §3.3, §11.2) -----------------------------------------------
# SESSION_IDLE_HOURS=8          # auth and index session idle timeout
# SESSION_MAX_DAYS=7            # auth and index session absolute lifetime (since the Entra sign-in)
# ADMIN_SESSION_IDLE_HOURS=2    # admin host session idle timeout
# ADMIN_REAUTH_HOURS=12         # admin host: Entra sign-in no older than this

# --- Optional -------------------------------------------------------------------
# Pending-user notifications to a Teams channel (SPECS.md §11.2, §20).
# TEAMS_WEBHOOK_URL=
# The IRM's heartbeat integration URL, pinged by a recurring job (SPECS.md §15).
# IRM_HEARTBEAT_URL=

# --- TLS behind a proxy ----------------------------------------------------------
# ASSUME_SSL=true    # Coolify/Traefik terminates TLS
# FORCE_SSL=true     # default; false only to try the production image over plain http
